{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run vercel-build",
  "env": {
    "NEXT_PUBLIC_COMMIT_SHA": "VERCEL_GIT_COMMIT_SHA",
    "NEXT_PUBLIC_BRANCH": "VERCEL_GIT_COMMIT_REF"
  },
  "redirects": [],
  "crons": [
    {
      "path": "/api/admin/cleanup/files",
      "schedule": "0 3 * * *"
    }
  ]
}
